### =========================================================
### CHAT
### =========================================================

### Send text message
POST {{baseUrl}}/api/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "I have launched an AI startup that helps developers build projects faster.",
  "settings": {
    "tone": "Professional",
    "audience": "Developers",
    "language": "English",
    "length": "Medium"
  }
}


### =========================================================
### CHAT - SPECIFIC PLATFORM
### =========================================================

### Generate LinkedIn content
POST {{baseUrl}}/api/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "I have launched an AI startup that helps developers build projects faster. Create a LinkedIn post.",
  "settings": {
    "tone": "Professional",
    "audience": "Developers and startup founders",
    "language": "English",
    "length": "Medium"
  }
}


### Generate Twitter/X content
POST {{baseUrl}}/api/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "I have launched an AI startup that helps developers build projects faster. Create a Twitter thread.",
  "settings": {
    "tone": "Engaging",
    "audience": "Developers",
    "language": "English",
    "length": "Short"
  }
}

### AI Product Launch
POST {{baseUrl}}/api/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Today we are launching CodePilot, an AI-powered developer assistant that helps developers understand code, generate boilerplate, find bugs and explain complex functions.",
  "settings": {
    "tone": "Exciting",
    "audience": "Software Developers",
    "language": "English",
    "length": "Medium"
  }
}

### =========================================================
### CHAT - IMAGE
### =========================================================

### Send image URL
POST {{baseUrl}}/api/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Analyze this image and create a LinkedIn post about it.",
  "images": [
    {
      "url": "https://res.cloudinary.com/demo/image/upload/sample.jpg"
    }
  ],
  "settings": {
    "tone": "Professional",
    "audience": "General Audience",
    "language": "English",
    "length": "Medium"
  }
}


### =========================================================
### CHAT - VIDEO
### =========================================================

### Send video URL
POST {{baseUrl}}/api/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Analyze this video and create social media content from it.",
  "videos": [
    {
      "url": "https://res.cloudinary.com/demo/video/upload/dog.mp4"
    }
  ],
  "settings": {
    "tone": "Engaging",
    "audience": "General Audience",
    "language": "English",
    "length": "Medium"
  }
}


### =========================================================
### CHAT - IMAGE + VIDEO
### =========================================================

### Send multimodal content
